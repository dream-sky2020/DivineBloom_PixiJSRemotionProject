<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- ========================================== -->
    <!-- 基础数据类型定义 -->
    <!-- ========================================== -->
    
    <!-- 混合模式枚举 -->
    <xs:simpleType name="BlendModeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="normal"/>
            <xs:enumeration value="add"/>
            <xs:enumeration value="multiply"/>
            <xs:enumeration value="screen"/>
            <xs:enumeration value="subtract"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ========================================== -->
    <!-- 关键帧复合类型定义 (解决多态 KEYFRAME 问题) -->
    <!-- ========================================== -->

    <!-- 1. 摄像机专属 Keyframe -->
    <xs:complexType name="CameraKeyframeType">
        <xs:attribute name="frame" type="xs:integer" use="required"/>
        <xs:attribute name="x" type="xs:float"/>
        <xs:attribute name="y" type="xs:float"/>
    </xs:complexType>

    <!-- 2. 精灵专属 Keyframe -->
    <xs:complexType name="SpriteKeyframeType">
        <xs:attribute name="frame" type="xs:integer" use="required"/>
        <xs:attribute name="atlas" type="xs:string"/>
        <xs:attribute name="atlasFrame" type="xs:string"/>
        <xs:attribute name="image" type="xs:string"/>
        <xs:attribute name="x" type="xs:float"/>
        <xs:attribute name="y" type="xs:float"/>
        <xs:attribute name="anchorX" type="xs:float"/>
        <xs:attribute name="anchorY" type="xs:float"/>
        <xs:attribute name="zIndex" type="xs:integer"/>
        <xs:attribute name="scaleX" type="xs:float"/>
        <xs:attribute name="scaleY" type="xs:float"/>
        <xs:attribute name="rotation" type="xs:float"/>
        <xs:attribute name="alpha" type="xs:float"/>
        <xs:attribute name="visible" type="xs:boolean"/>
        <xs:attribute name="blendMode" type="BlendModeType"/>
        <xs:attribute name="tint" type="xs:string"/>
        <xs:attribute name="active" type="xs:boolean"/>
    </xs:complexType>

    <!-- 3. 粒子容器专属 Keyframe -->
    <xs:complexType name="ParticleContainerKeyframeType">
        <xs:attribute name="frame" type="xs:integer" use="required"/>
        <xs:attribute name="atlas" type="xs:string"/>
        <xs:attribute name="zIndex" type="xs:integer"/>
        <xs:attribute name="blendMode" type="BlendModeType"/>
        <xs:attribute name="visible" type="xs:boolean"/>
        <xs:attribute name="active" type="xs:boolean"/>
    </xs:complexType>

    <!-- 4. 单个粒子专属 Keyframe -->
    <xs:complexType name="ParticleKeyframeType">
        <xs:attribute name="frame" type="xs:integer" use="required"/>
        <xs:attribute name="atlasFrame" type="xs:string"/>
        <xs:attribute name="x" type="xs:float"/>
        <xs:attribute name="y" type="xs:float"/>
        <xs:attribute name="scaleX" type="xs:float"/>
        <xs:attribute name="scaleY" type="xs:float"/>
        <xs:attribute name="anchorX" type="xs:float"/>
        <xs:attribute name="anchorY" type="xs:float"/>
        <xs:attribute name="rotation" type="xs:float"/>
        <xs:attribute name="alpha" type="xs:float"/>
        <xs:attribute name="tint" type="xs:string"/>
        <xs:attribute name="active" type="xs:boolean"/>
    </xs:complexType>

    <!-- ========================================== -->
    <!-- 渲染实体元素定义 -->
    <!-- ========================================== -->

    <!-- 根节点 Canvas -->
    <xs:element name="Canvas">
        <xs:complexType>
            <!-- 允许 CAMERA, SPRITE, PARTICLECONTAINER 任意组合和顺序 -->
            <xs:choice maxOccurs="unbounded">
                
                <!-- CAMERA 节点 -->
                <xs:element name="CAMERA" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- CAMERA 内部的 KEYFRAME 采用 CameraKeyframeType，最少 1 个 -->
                            <xs:element name="KEYFRAME" type="CameraKeyframeType" minOccurs="1" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>

                <!-- SPRITE 节点 -->
                <xs:element name="SPRITE" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- SPRITE 内部的 KEYFRAME 采用 SpriteKeyframeType，最少 1 个 -->
                            <xs:element name="KEYFRAME" type="SpriteKeyframeType" minOccurs="1" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>

                <!-- PARTICLECONTAINER 节点 -->
                <xs:element name="PARTICLECONTAINER" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <!-- 容器内可以包含 KEYFRAME 和 PARTICLE 节点 -->
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="KEYFRAME" type="ParticleContainerKeyframeType" minOccurs="1" maxOccurs="unbounded"/>
                            <xs:element name="PARTICLE" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <!-- PARTICLE 内部的 KEYFRAME -->
                                        <xs:element name="KEYFRAME" type="ParticleKeyframeType" minOccurs="1" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                        <xs:attribute name="id" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>

            </xs:choice>
            
            <!-- Canvas 属性 -->
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="width" type="xs:integer"/>
            <xs:attribute name="height" type="xs:integer"/>
            <xs:attribute name="fps" type="xs:integer"/>
            <xs:attribute name="totalFrames" type="xs:integer"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
