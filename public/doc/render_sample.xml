<?xml version="1.0" encoding="UTF-8"?>
<Video
    name="battle_replay_01"
    fps="30"
    totalFrames="2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="render_dsl.xsd">

    <!-- 第一帧：初始化场景 -->
    <FRAME id="0" cameraX="0.0" cameraY="0.0">
        <!-- 背景角色 -->
        <SPRITE 
            id="hero_bg" 
            image="image/hero.png" 
            x="400.0" 
            y="300.0" 
            anchorX="0.5" 
            anchorY="0.5" 
            zIndex="0" 
            alpha="0.3"
        />
        
        <!-- 场景物品 -->
        <SPRITE 
            id="dish_01" 
            image="image/pixelfood1/01_dish.png" 
            x="200.0" 
            y="400.0" 
            zIndex="1"
        />
        
        <SPRITE 
            id="pie_01" 
            image="image/pixelfood1/05_apple_pie.png" 
            x="200.0" 
            y="390.0" 
            zIndex="2" 
            scaleX="1.2" 
            scaleY="1.2"
        />
    </FRAME>

    <!-- 第二帧：发生位移或状态变化 -->
    <FRAME id="1" cameraX="10.0" cameraY="5.0">
        <SPRITE 
            id="hero_bg" 
            image="image/hero.png" 
            x="410.0" 
            y="305.0" 
            anchorX="0.5" 
            anchorY="0.5" 
            zIndex="0" 
            alpha="0.5" 
            rotation="0.1"
        />
        
        <SPRITE 
            id="dish_01" 
            image="image/pixelfood1/01_dish.png" 
            x="210.0" 
            y="405.0" 
            zIndex="1" 
            tint="0xff0000"
        />
        
        <SPRITE 
            id="pie_01" 
            image="image/pixelfood1/05_apple_pie.png" 
            x="210.0" 
            y="395.0" 
            zIndex="2" 
            visible="false"
        />
    </FRAME>

</Video>
