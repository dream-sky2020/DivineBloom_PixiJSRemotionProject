<World>
    <EngineConfig>
        <SystemPipeline>
            <System name="InputSystem" enabled="true" />
            <System name="SignalSystem" enabled="true" />
            <System name="AnimationSystem" enabled="true" />
            <System name="RenderSystem" enabled="true" />
        </SystemPipeline>

        <!-- 1. 输入配置：绑定 R, A, D, 方向键和空格 -->
        <InputConfig mode="strict">
            <ActionMaps active="gameplay">
                <ActionMap id="gameplay">
                    <Action id="shuffle" type="button" />
                    <Action id="prev" type="button" />
                    <Action id="next" type="button" />
                    <Action id="throw" type="button" />
                </ActionMap>
            </ActionMaps>
            <Bindings>
                <Binding action="shuffle" path="Keyboard/R" />
                <Binding action="prev" path="Keyboard/A" />
                <Binding action="prev" path="Keyboard/LeftArrow" />
                <Binding action="next" path="Keyboard/D" />
                <Binding action="next" path="Keyboard/RightArrow" />
                <Binding action="throw" path="Keyboard/Space" />
            </Bindings>
        </InputConfig>

        <!-- 2. 输入转信号 -->
        <InputToSignalMap>
            <Route action="shuffle" phase="pressed" emit="card.action.shuffle" />
            <Route action="prev" phase="pressed" emit="card.action.prev" />
            <Route action="next" phase="pressed" emit="card.action.next" />
            <Route action="throw" phase="pressed" emit="card.action.throw" />
        </InputToSignalMap>

        <!-- 3. 舞台剧本库：使用变量和函数计算布局 -->
        <StageScriptLibrary mode="strict">
            <!-- 扇形布局剧本：利用函数计算每张牌的 X, Y 和 旋转 -->
            <StageScript id="stage.card.fan_layout" duration="20">
                <AnimationVars>
                    <Var name="index" from="arg.index" type="number" required="true" />
                    <Var name="total" from="arg.total" type="number" required="true" />
                    <!-- 调用注册的外部函数计算扇形坐标 -->
                    <Var name="targetX" functionRef="anim.card.hand.fanX@v1" args="vars.index,vars.total,70" type="number" />
                    <Var name="targetY" functionRef="anim.card.hand.fanY@v1" args="vars.index,vars.total" type="number" />
                    <Var name="targetRot" functionRef="anim.card.hand.fanRot@v1" args="vars.index,vars.total" type="number" />
                </AnimationVars>
                <Tracks>
                    <Track role="card" prop="transform.position.x" interpolation="linear">
                        <Key frame="0" valueFromVar="targetX" />
                        <Key frame="20" valueFromVar="targetX" />
                    </Track>
                    <Track role="card" prop="transform.position.y" interpolation="linear">
                        <Key frame="0" valueFromVar="targetY" />
                        <Key frame="20" valueFromVar="targetY" />
                    </Track>
                    <Track role="card" prop="transform.rotation" interpolation="linear">
                        <Key frame="0" valueFromVar="targetRot" />
                        <Key frame="20" valueFromVar="targetRot" />
                    </Track>
                </Tracks>
            </StageScript>

            <!-- 选中动画：牌向上弹起并放大 -->
            <StageScript id="stage.card.selected" duration="15">
                <Tracks>
                    <Track role="card" prop="transform.position.y" interpolation="linear" valueMode="relative">
                        <Key frame="0" value="0" />
                        <Key frame="15" value="-60" easing="cubic-bezier(0.25, 0.1, 0.25, 1.0)" />
                    </Track>
                    <Track role="card" prop="transform.scale" interpolation="linear">
                        <Key frame="0" value="1, 1, 1" />
                        <Key frame="15" value="1.2, 1.2, 1" />
                    </Track>
                </Tracks>
            </StageScript>

            <!-- 扔出动画：牌向上飞出并消失 -->
            <StageScript id="stage.card.throw" duration="25">
                <Tracks>
                    <Track role="card" prop="transform.position.y" interpolation="linear" valueMode="relative">
                        <Key frame="0" value="0" />
                        <Key frame="25" value="-1000" easing="cubic-bezier(0.5, 0, 0.75, 0)" />
                    </Track>
                    <Track role="card" prop="sprite.alpha" interpolation="linear">
                        <Key frame="0" value="1.0" />
                        <Key frame="25" value="0.0" />
                    </Track>
                </Tracks>
                <Cues>
                    <Cue frame="25" signal="card.event.thrown_complete" />
                </Cues>
            </StageScript>
        </StageScriptLibrary>
    </EngineConfig>

    <Canvas name="card_pile_scene" width="1280" height="720" background="#0f172a" />

    <!-- 4. 预制体库：定义单张卡片 -->
    <PrefabLibrary>
        <Prefab id="card_template">
            <GameObject name="Card">
                <Transform position="640, 650, 0" />
                <!-- 使用 digit 的 SVG 图片 -->
                <Sprite texture="digit/digit_1.svg" anchor="0.5, 0.5" layer="10" />
                <AnimationController mode="layered" actions="playLayerOnce,setLayerLabel" />
            </GameObject>
        </Prefab>
    </PrefabLibrary>

    <!-- 5. 舞台导演：管理卡片堆逻辑 -->
    <GameObject name="CardDirector" id="card_director">
        <StageDirectorController 
            id="director.cards" 
            scope="cards.player" 
            actions="playScript,stopAll" 
        />
        <SignalConfig>
            <!-- 接收洗牌信号 -->
            <On event="card.action.shuffle" target="StageDirector" action="playScript">
                <Args scriptId="stage.card.fan_layout" />
            </On>
            <!-- 接收扔出信号 -->
            <On event="card.action.throw" target="StageDirector" action="playScript">
                <Args scriptId="stage.card.throw" bind.card="payload.selectedId" />
            </On>
        </SignalConfig>
    </GameObject>

    <!-- 6. 实例化卡片（示例 5 张） -->
    <Instance prefab="card_template" id="card_0" name="Card0">
        <Sprite texture="digit/digit_0.svg" />
    </Instance>
    <Instance prefab="card_template" id="card_1" name="Card1">
        <Sprite texture="digit/digit_1.svg" />
    </Instance>
    <Instance prefab="card_template" id="card_2" name="Card2">
        <Sprite texture="digit/digit_2.svg" />
    </Instance>
    <Instance prefab="card_template" id="card_3" name="Card3">
        <Sprite texture="digit/digit_3.svg" />
    </Instance>
    <Instance prefab="card_template" id="card_4" name="Card4">
        <Sprite texture="digit/digit_4.svg" />
    </Instance>

</World>