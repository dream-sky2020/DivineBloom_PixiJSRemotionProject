<World>
    <Canvas name="behavior_demo" width="1280" height="720" background="#020817" />
    <EngineConfig>
        <SystemPipeline>
            <System name="InputSystem" enabled="true" />
            <System name="BehaviorSystem" enabled="true" />
            <System name="AnimationSystem" enabled="true" />
            <System name="PhysicsSystem" enabled="true" />
            <System name="RenderSystem" enabled="true" />
        </SystemPipeline>
    </EngineConfig>

    <!-- 静态边界 (墙壁) -->
    <GameObject id="wall-bottom">
        <Transform position="640, 770, 0" />
        <RigidBody type="static" restitution="1.0" friction="0.0" />
        <BoxCollider width="1280" height="100" />
    </GameObject>
    <GameObject id="wall-top">
        <Transform position="640, -50, 0" />
        <RigidBody type="static" restitution="1.0" friction="0.0" />
        <BoxCollider width="1280" height="100" />
    </GameObject>
    <GameObject id="wall-left">
        <Transform position="-50, 360, 0" />
        <RigidBody type="static" restitution="1.0" friction="0.0" />
        <BoxCollider width="100" height="720" />
    </GameObject>
    <GameObject id="wall-right">
        <Transform position="1330, 360, 0" />
        <RigidBody type="static" restitution="1.0" friction="0.0" />
        <BoxCollider width="100" height="720" />
    </GameObject>

    <!-- 携带 Behavior 的动态物体 -->
    <GameObject id="digit-obj-1">
        <Transform position="200, 200, 0" />
        <RigidBody type="dynamic" restitution="0.8" friction="0.5" linearVelocity="100, 100" />
        <CircleCollider radius="40" />
        <Sprite texture="digit/digit_0.svg" anchor="0.5, 0.5" />
        <Behavior type="DigitCycle" />
        <Animation defaultLabel="cycle">
            <Label name="cycle" duration="180" loop="true">
                <Track prop="Sprite.texture.image" interpolation="hold">
                    <Key frame="0" value="digit/digit_0.svg" />
                    <Key frame="18" value="digit/digit_1.svg" />
                    <Key frame="36" value="digit/digit_2.svg" />
                    <Key frame="54" value="digit/digit_3.svg" />
                    <Key frame="72" value="digit/digit_4.svg" />
                    <Key frame="90" value="digit/digit_5.svg" />
                    <Key frame="108" value="digit/digit_6.svg" />
                    <Key frame="126" value="digit/digit_7.svg" />
                    <Key frame="144" value="digit/digit_8.svg" />
                    <Key frame="162" value="digit/digit_9.svg" />
                </Track>
            </Label>
        </Animation>
    </GameObject>

    <GameObject id="digit-obj-2">
        <Transform position="400, 300, 0" />
        <RigidBody type="dynamic" restitution="0.8" friction="0.5" linearVelocity="-200, 150" />
        <CircleCollider radius="40" />
        <Sprite texture="digit/digit_0.svg" anchor="0.5, 0.5" />
        <Behavior type="DigitCycle" />
        <Animation defaultLabel="cycle">
            <Label name="cycle" duration="300" loop="true">
                <Track prop="Sprite.texture.image" interpolation="hold">
                    <Key frame="0" value="digit/digit_0.svg" />
                    <Key frame="30" value="digit/digit_1.svg" />
                    <Key frame="60" value="digit/digit_2.svg" />
                    <Key frame="90" value="digit/digit_3.svg" />
                    <Key frame="120" value="digit/digit_4.svg" />
                    <Key frame="150" value="digit/digit_5.svg" />
                    <Key frame="180" value="digit/digit_6.svg" />
                    <Key frame="210" value="digit/digit_7.svg" />
                    <Key frame="240" value="digit/digit_8.svg" />
                    <Key frame="270" value="digit/digit_9.svg" />
                </Track>
            </Label>
        </Animation>
    </GameObject>

    <GameObject id="digit-obj-3">
        <Transform position="600, 400, 0" />
        <RigidBody type="dynamic" restitution="0.8" friction="0.5" linearVelocity="150, -100" />
        <CircleCollider radius="40" />
        <Sprite texture="digit/digit_0.svg" anchor="0.5, 0.5" />
        <Behavior type="DigitCycle" />
        <Animation defaultLabel="cycle">
            <Label name="cycle" duration="120" loop="true">
                <Track prop="Sprite.texture.image" interpolation="hold">
                    <Key frame="0" value="digit/digit_0.svg" />
                    <Key frame="12" value="digit/digit_1.svg" />
                    <Key frame="24" value="digit/digit_2.svg" />
                    <Key frame="36" value="digit/digit_3.svg" />
                    <Key frame="48" value="digit/digit_4.svg" />
                    <Key frame="60" value="digit/digit_5.svg" />
                    <Key frame="72" value="digit/digit_6.svg" />
                    <Key frame="84" value="digit/digit_7.svg" />
                    <Key frame="96" value="digit/digit_8.svg" />
                    <Key frame="108" value="digit/digit_9.svg" />
                </Track>
            </Label>
        </Animation>
    </GameObject>

    <GameObject id="digit-obj-4">
        <Transform position="800, 200, 0" />
        <RigidBody type="dynamic" restitution="0.8" friction="0.5" linearVelocity="-100, -200" />
        <CircleCollider radius="40" />
        <Sprite texture="digit/digit_0.svg" anchor="0.5, 0.5" />
        <Behavior type="DigitCycle" />
        <Animation defaultLabel="cycle">
            <Label name="cycle" duration="240" loop="true">
                <Track prop="Sprite.texture.image" interpolation="hold">
                    <Key frame="0" value="digit/digit_0.svg" />
                    <Key frame="24" value="digit/digit_1.svg" />
                    <Key frame="48" value="digit/digit_2.svg" />
                    <Key frame="72" value="digit/digit_3.svg" />
                    <Key frame="96" value="digit/digit_4.svg" />
                    <Key frame="120" value="digit/digit_5.svg" />
                    <Key frame="144" value="digit/digit_6.svg" />
                    <Key frame="168" value="digit/digit_7.svg" />
                    <Key frame="192" value="digit/digit_8.svg" />
                    <Key frame="216" value="digit/digit_9.svg" />
                </Track>
            </Label>
        </Animation>
    </GameObject>

    <GameObject id="digit-obj-5">
        <Transform position="1000, 500, 0" />
        <RigidBody type="dynamic" restitution="0.8" friction="0.5" linearVelocity="50, 300" />
        <CircleCollider radius="40" />
        <Sprite texture="digit/digit_0.svg" anchor="0.5, 0.5" />
        <Behavior type="DigitCycle" />
        <Animation defaultLabel="cycle">
            <Label name="cycle" duration="360" loop="true">
                <Track prop="Sprite.texture.image" interpolation="hold">
                    <Key frame="0" value="digit/digit_0.svg" />
                    <Key frame="36" value="digit/digit_1.svg" />
                    <Key frame="72" value="digit/digit_2.svg" />
                    <Key frame="108" value="digit/digit_3.svg" />
                    <Key frame="144" value="digit/digit_4.svg" />
                    <Key frame="180" value="digit/digit_5.svg" />
                    <Key frame="216" value="digit/digit_6.svg" />
                    <Key frame="252" value="digit/digit_7.svg" />
                    <Key frame="288" value="digit/digit_8.svg" />
                    <Key frame="324" value="digit/digit_9.svg" />
                </Track>
            </Label>
        </Animation>
    </GameObject>

    <!-- 添加一些普通物体作为对比 -->
    <GameObject id="normal-circle">
        <Transform position="640, 360, 0" />
        <RigidBody type="dynamic" restitution="1.0" friction="0.0" linearVelocity="0, 0" />
        <CircleCollider radius="50" />
        <Graphic kind="circleGraphic" radius="50" fillColor="#ff0000" fillAlpha="0.5" />
    </GameObject>
</World>
