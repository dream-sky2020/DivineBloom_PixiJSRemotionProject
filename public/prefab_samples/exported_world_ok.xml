                <Graphic kind="circleGraphic" radius="26" fillColor="#7ee7d9" strokeColor="#ffffff" strokeWidth="2" />
            </GameObject>
        </Prefab>

        <Prefab id="enemy_variant">
            <GameObject name="EnemyVariantTemplate">
                <Transform position="0, 0, 0" />
                <RigidBody type="dynamic" restitution="0.8" friction="0.2" />
