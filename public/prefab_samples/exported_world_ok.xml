                <Graphic kind="circleGraphic" radius="20" fillColor="#f97316" strokeColor="#ffffff" strokeWidth="2" />
            </GameObject>
        </Prefab>
    </PrefabLibrary>

    <GameObject id="preview_floor" name="PreviewFloor">
        <Transform position="640, 700, 0" />
