<World>
    <EngineConfig>
        <SystemPipeline>
            <System name="InputSystem" enabled="true" />
            <System name="SignalSystem" enabled="true" />
            <System name="AnimationSystem" enabled="true" />
            <System name="RenderSystem" enabled="true" />
        </SystemPipeline>
    </EngineConfig>

    <Canvas name="multi_director_stage_demo" width="1280" height="720" background="#020817" />

    <!-- Director A: 战场 A -->
    <GameObject name="DirectorA" id="director_go_a">
        <StageDirectorController
            id="director.battlefield.A"
            scope="battlefield.A"
            enabled="true"
            conflictPolicy="localFirst"
            maxActiveInstances="8"
            defaultPriority="10"
            allowCrossScope="false"
            actions="playScript,stopScript,stopAll,pauseScript,resumeScript"
        />
    </GameObject>

    <!-- Director B: 战场 B -->
    <GameObject name="DirectorB" id="director_go_b">
        <StageDirectorController
            id="director.battlefield.B"
            scope="battlefield.B"
            enabled="true"
            conflictPolicy="localFirst"
            maxActiveInstances="8"
            defaultPriority="10"
            allowCrossScope="false"
            actions="playScript,stopScript,stopAll,pauseScript,resumeScript"
        />
    </GameObject>

    <!-- 战场 A 演员 -->
    <GameObject name="HeroA" id="hero_a">
        <Transform position="320, 360, 0" />
        <Graphic kind="circleGraphic" radius="24" fillColor="#38bdf8" strokeColor="#ffffff" strokeWidth="2" />
        <Animations defaultLabel="idle">
            <Label name="idle" duration="30" loop="true">
                <Track prop="transform.position.y" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="15" value="-8" />
                    <Key frame="30" value="0" />
                </Track>
            </Label>
            <Label name="run" duration="20" loop="true">
                <Track prop="transform.position.x" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="-10" />
                    <Key frame="10" value="10" />
                    <Key frame="20" value="-10" />
                </Track>
            </Label>
            <Label name="shoot" duration="12" loop="false">
                <Track prop="transform.rotation" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="6" value="-0.2" />
                    <Key frame="12" value="0" />
                </Track>
            </Label>
            <Label name="flash" duration="8" loop="false">
                <Track prop="graphic.fill.alpha" interpolation="linear" valueMode="absolute">
                    <Key frame="0" value="1" />
                    <Key frame="4" value="0.3" />
                    <Key frame="8" value="1" />
                </Track>
            </Label>
        </Animations>
        <AnimationController
            mode="layered"
            layerConflictPolicy="byMask"
            actions="setLabel,playOnce,pause,resume,setSpeed,setLoopOverride,setLayerLabel,playLayerOnce,pauseLayer,resumeLayer,setLayerWeight,enableLayer,disableLayer"
        >
            <Layers>
                <Layer id="lowerBody" priority="10" enabled="true" writeMask="transform.position.*,transform.rotation">
                    <State currentLabel="run" playing="true" localFrame="0" speedScale="1.0" direction="forward" />
                </Layer>
                <Layer id="upperBody" priority="20" enabled="true" writeMask="transform.rotation">
                    <State currentLabel="shoot" playing="true" localFrame="0" speedScale="1.0" direction="forward" />
                </Layer>
                <Layer id="fx" priority="100" enabled="true" blendMode="additive" writeMask="graphic.fill.alpha">
                    <State currentLabel="flash" playing="true" localFrame="0" speedScale="1.0" direction="forward" />
                </Layer>
            </Layers>
        </AnimationController>
        <SignalConfig>
            <On event="combat.a.skill.cast" target="StageDirectorController" action="playScript" priority="100">
                <Args directorId="director.battlefield.A" scope="battlefield.A" scriptId="stage.a.combo_01" bind.attacker="self.id" />
            </On>
        </SignalConfig>
    </GameObject>

    <!-- 战场 B 演员 -->
    <GameObject name="HeroB" id="hero_b">
        <Transform position="960, 360, 0" />
        <Graphic kind="rectangleGraphic" width="44" height="44" fillColor="#f97316" strokeColor="#ffffff" strokeWidth="2" />
        <Animations defaultLabel="idle">
            <Label name="idle" duration="30" loop="true">
                <Track prop="transform.position.y" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="15" value="-6" />
                    <Key frame="30" value="0" />
                </Track>
            </Label>
            <Label name="run" duration="20" loop="true">
                <Track prop="transform.position.x" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="8" />
                    <Key frame="10" value="-8" />
                    <Key frame="20" value="8" />
                </Track>
            </Label>
            <Label name="shoot" duration="10" loop="false">
                <Track prop="transform.scale.x" interpolation="linear" valueMode="absolute">
                    <Key frame="0" value="1" />
                    <Key frame="5" value="1.1" />
                    <Key frame="10" value="1" />
                </Track>
            </Label>
            <Label name="flash" duration="6" loop="false">
                <Track prop="graphic.fill.alpha" interpolation="linear" valueMode="absolute">
                    <Key frame="0" value="1" />
                    <Key frame="3" value="0.25" />
                    <Key frame="6" value="1" />
                </Track>
            </Label>
        </Animations>
        <AnimationController
            mode="layered"
            layerConflictPolicy="byMask"
            actions="setLabel,playOnce,pause,resume,setSpeed,setLoopOverride,setLayerLabel,playLayerOnce,pauseLayer,resumeLayer,setLayerWeight,enableLayer,disableLayer"
        >
            <Layers>
                <Layer id="lowerBody" priority="10" enabled="true" writeMask="transform.position.*">
                    <State currentLabel="run" playing="true" localFrame="0" speedScale="1.0" direction="forward" />
                </Layer>
                <Layer id="upperBody" priority="20" enabled="true" writeMask="transform.scale.*">
                    <State currentLabel="shoot" playing="true" localFrame="0" speedScale="1.0" direction="forward" />
                </Layer>
                <Layer id="fx" priority="100" enabled="true" blendMode="additive" writeMask="graphic.fill.alpha">
                    <State currentLabel="flash" playing="true" localFrame="0" speedScale="1.0" direction="forward" />
                </Layer>
            </Layers>
        </AnimationController>
        <SignalConfig>
            <On event="combat.b.skill.cast" target="StageDirectorController" action="playScript" priority="100">
                <Args directorId="director.battlefield.B" scope="battlefield.B" scriptId="stage.b.combo_01" bind.attacker="self.id" />
            </On>
        </SignalConfig>
    </GameObject>

    <!-- 战场 A 增援 -->
    <GameObject name="AllyA1" id="ally_a_1">
        <Transform position="180, 300, 0" />
        <Graphic kind="rectangleGraphic" width="36" height="36" fillColor="#0ea5e9" strokeColor="#ffffff" strokeWidth="2" />
        <Animations defaultLabel="charge">
            <Label name="charge" duration="24" loop="true">
                <Track prop="transform.position.x" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="12" value="280" />
                    <Key frame="24" value="0" />
                </Track>
                <Track prop="transform.position.y" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="12" value="-12" />
                    <Key frame="24" value="0" />
                </Track>
            </Label>
        </Animations>
        <AnimationController mode="single" currentLabel="charge" playing="true" />
    </GameObject>

    <GameObject name="AllyA2" id="ally_a_2">
        <Transform position="240, 430, 0" />
        <Graphic kind="circleGraphic" radius="18" fillColor="#22d3ee" strokeColor="#ffffff" strokeWidth="2" />
        <Animations defaultLabel="charge">
            <Label name="charge" duration="26" loop="true">
                <Track prop="transform.position.x" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="13" value="250" />
                    <Key frame="26" value="0" />
                </Track>
                <Track prop="transform.rotation" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="13" value="0.35" />
                    <Key frame="26" value="0" />
                </Track>
            </Label>
        </Animations>
        <AnimationController mode="single" currentLabel="charge" playing="true" />
    </GameObject>

    <!-- 战场 B 增援 -->
    <GameObject name="AllyB1" id="ally_b_1">
        <Transform position="1100, 300, 0" />
        <Graphic kind="rectangleGraphic" width="36" height="36" fillColor="#fb923c" strokeColor="#ffffff" strokeWidth="2" />
        <Animations defaultLabel="charge">
            <Label name="charge" duration="24" loop="true">
                <Track prop="transform.position.x" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="12" value="-280" />
                    <Key frame="24" value="0" />
                </Track>
                <Track prop="transform.position.y" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="12" value="-10" />
                    <Key frame="24" value="0" />
                </Track>
            </Label>
        </Animations>
        <AnimationController mode="single" currentLabel="charge" playing="true" />
    </GameObject>

    <GameObject name="AllyB2" id="ally_b_2">
        <Transform position="1040, 430, 0" />
        <Graphic kind="circleGraphic" radius="18" fillColor="#f59e0b" strokeColor="#ffffff" strokeWidth="2" />
        <Animations defaultLabel="charge">
            <Label name="charge" duration="26" loop="true">
                <Track prop="transform.position.x" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="13" value="-250" />
                    <Key frame="26" value="0" />
                </Track>
                <Track prop="transform.rotation" interpolation="linear" valueMode="relative">
                    <Key frame="0" value="0" />
                    <Key frame="13" value="-0.35" />
                    <Key frame="26" value="0" />
                </Track>
            </Label>
        </Animations>
        <AnimationController mode="single" currentLabel="charge" playing="true" />
    </GameObject>
</World>
