<World>
    <EngineConfig>
        <SystemPipeline>
            <System name="InputSystem" enabled="true" />
            <System name="AnimationSystem" enabled="true" />
            <System name="RenderSystem" enabled="true" />
        </SystemPipeline>

        <InputConfig mode="strict" devicePolicy="keyboard">
            <ActionMaps active="gameplay">
                <ActionMap id="gameplay" enabled="true">
                    <Action id="rotate.start" type="button" />
                    <Action id="rotate.stop" type="button" />
                </ActionMap>
            </ActionMaps>
            <Bindings>
                <Binding action="rotate.start" map="gameplay" path="Keyboard/R" />
                <Binding action="rotate.stop" map="gameplay" path="Keyboard/P" />
            </Bindings>
        </InputConfig>

        <InputToSignalMap defaultMap="gameplay">
            <Route action="rotate.start" phase="pressed" emit="input.rotate.start" />
            <Route action="rotate.stop" phase="pressed" emit="input.rotate.stop" />
        </InputToSignalMap>
    </EngineConfig>

