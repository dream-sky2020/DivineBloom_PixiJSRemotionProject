<World>
    <Canvas name="pseudo_3d_mobile_init" width="1080" height="1920" background="#020817" />

    <EngineConfig>
        <SystemPipeline>
            <System name="RenderSystem" enabled="true" />
        </SystemPipeline>
    </EngineConfig>

    <!-- Mobile portrait 1080 x 1920 -->
    <GameObject name="MainCamera" id="camera_main">
        <Camera x="0" y="0" z="0" focus="540" />
    </GameObject>

    <!-- 1. 远端背景墙 (尽头) -->
    <GameObject name="FarWall" id="env_bg">
        <Transform position="540, 960, 0" />
        <Graphic
            kind="rectangleGraphic"
            width="270"
            height="480"
            fillColor="#18122b"
            fillAlpha="1.0"
        />
    </GameObject>

    <!-- 2. 地板 (Floor) -->
    <GameObject name="Floor" id="env_floor">
        <Transform position="0, 0, 0" />
        <Graphic
            kind="polygonGraphic"
            anchor="0,0"
            points="0,1920 1080,1920 675,1200 405,1200"
            fillColor="#1f2f57"
            fillAlpha="1.0"
            strokeColor="#5f7cc5"
            strokeWidth="1"
        />
    </GameObject>

    <!-- 3. 天花板 (Ceiling) -->
    <GameObject name="Ceiling" id="env_ceiling">
        <Transform position="0, 0, 0" />
        <Graphic
            kind="polygonGraphic"
            anchor="0,0"
            points="0,0 1080,0 675,720 405,720"
            fillColor="#111a34"
            fillAlpha="1.0"
            strokeColor="#4d5f95"
            strokeWidth="1"
        />
    </GameObject>

    <!-- 4. 左侧墙壁 (Left Wall) -->
    <GameObject name="LeftWall" id="env_wall_l">
        <Transform position="0, 0, 0" />
        <Graphic
            kind="polygonGraphic"
            anchor="0,0"
            points="0,0 405,720 405,1200 0,1920"
            fillColor="#0f2744"
            fillAlpha="1.0"
            strokeColor="#55b8d9"
            strokeWidth="1"
        />
    </GameObject>

    <!-- 5. 右侧墙壁 (Right Wall) -->
    <GameObject name="RightWall" id="env_wall_r">
        <Transform position="675, 0, 0" />
        <Graphic
            kind="polygonGraphic"
            anchor="0,0"
            points="405,0 0,720 0,1200 405,1920"
            fillColor="#3a224f"
            fillAlpha="1.0"
            strokeColor="#ff8f70"
            strokeWidth="1"
        />
    </GameObject>

    <!-- === 友军 (左侧走廊) === -->
    <GameObject name="Ally_Near" id="ally_1">
        <Transform position="243, 1536, 0" scale="2.5, 2.5, 1" />
        <Graphic
            kind="circleGraphic"
            radius="20"
            fillColor="#7ee7d9"
            strokeColor="#ffffff"
            strokeWidth="2"
        />
    </GameObject>

    <GameObject name="Ally_Mid" id="ally_2">
        <Transform position="351, 1216, 0" scale="1.4, 1.4, 1" />
        <Graphic
            kind="circleGraphic"
            radius="20"
            fillColor="#7ee7d9"
            fillAlpha="0.8"
        />
    </GameObject>

    <GameObject name="Ally_Far" id="ally_3">
        <Transform position="432, 1056, 0" scale="0.7, 0.7, 1" />
        <Graphic
            kind="circleGraphic"
            radius="20"
            fillColor="#7ee7d9"
            fillAlpha="0.5"
        />
    </GameObject>

    <!-- === 敌人 (右侧走廊) === -->
    <GameObject name="Enemy_Near" id="enemy_1">
        <Transform position="837, 1536, 0" scale="2.5, 2.5, 1" />
        <Graphic
            kind="polygonGraphic"
            points="0,-20 20,20 -20,20"
            fillColor="#ffce73"
            strokeColor="#ffffff"
            strokeWidth="2"
        />
    </GameObject>

    <GameObject name="Enemy_Mid" id="enemy_2">
        <Transform position="729, 1216, 0" scale="1.4, 1.4, 1" />
        <Graphic
            kind="polygonGraphic"
            points="0,-20 20,20 -20,20"
            fillColor="#ffce73"
            fillAlpha="0.8"
        />
    </GameObject>

    <GameObject name="Enemy_Far" id="enemy_3">
        <Transform position="648, 1056, 0" scale="0.7, 0.7, 1" />
        <Graphic
            kind="polygonGraphic"
            points="0,-20 20,20 -20,20"
            fillColor="#ffce73"
            fillAlpha="0.5"
        />
    </GameObject>
</World>
